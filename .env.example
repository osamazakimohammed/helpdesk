APP_ENV=production
PORT=8080
BASE_URL=http://localhost:8080

# Database & Connection Pool (PostgreSQL 17 / PgBouncer in transaction mode)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/helpdesk?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
JWT_SECRET=super-secure-default-jwt-secret-key-change-in-prod
JWT_ISSUER=helpdesk
JWT_EXPIRY_HOURS=72

# Storage (S3 / MinIO)
S3_ENDPOINT=localhost:9000
S3_REGION=us-east-1
S3_BUCKET=helpdesk-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false

# Inbound & Outbound Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=support@helpdesk.local

# OpenTelemetry
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# Initial Admin Credentials (Seeded on first run)
ADMIN_EMAIL=admin@helpdesk.local
ADMIN_PASSWORD=AdminPass123!
